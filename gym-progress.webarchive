bplist00”=π_WebSubframeArchives_WebSubresources_WebMainResource¢2”.°—’	
^WebResourceURL_WebResourceTextEncodingName_WebResourceData_WebResourceMIMEType_WebResourceFrameName[about:blankUUTF-8O£8<!DOCTYPE html><html lang="de-DE" class="transparentSkybridgeBackground desktopSkybridge light" data-theme="light" style="color-scheme: light; --safe-area-inset-top: 0px; --safe-area-inset-bottom: 0px; --safe-area-inset-left: 0px; --safe-area-inset-right: 0px;"><head><style>@layer sandbox-defaults{html,body,#root{margin:0;padding:0}}</style><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#111827"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="GYM Progress"><link rel="manifest" href="manifest.webmanifest"><title>GYM Progress</title><style>
:root{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#eff6ff;background:#0b1120;font-size:16px}*{box-sizing:border-box}body{margin:0;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}main{max-width:720px;margin:auto;padding:18px}h1{font-size:26px;letter-spacing:-.7px;margin:5px 0}h2{font-size:18px;margin:0 0 12px}p{line-height:1.5;color:#bac8d8}header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:22px}.small{font-size:12px;color:#92a4ba}.panel{border:1px solid #28364c;background:#151e30;border-radius:18px;padding:18px;margin:14px 0;box-shadow:0 6px 24px #060b153d}label{display:block;font-weight:600;font-size:13px;color:#c8d6e6;margin-bottom:5px}input,select{width:100%;height:44px;border-radius:10px;border:1px solid #3b4a60;background:#0d1626;color:#fff;padding:0 11px;font-size:16px}input:focus,select:focus{outline:2px solid #60a5fa}.cols{display:grid;grid-template-columns:1fr 1fr;gap:12px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.field{margin:12px 0}.button{border:0;border-radius:11px;padding:12px 16px;min-height:44px;background:#60a5fa;color:#07111d;font-weight:750;font-size:15px;cursor:pointer}.button.alt{background:#29394f;color:#e0eaf5}.button.danger{background:#553041;color:#ffe2e7}.button:disabled{opacity:.55}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.pill{display:inline-block;font-size:12px;border-radius:40px;padding:5px 9px;background:#273d51;color:#add6ff}.ok{background:#173d31;color:#7de4ae}.warn{background:#4b341b;color:#fcd78d}.setrow{display:grid;grid-template-columns:32px 1fr 1fr 1fr 40px;align-items:end;gap:7px;margin:9px 0}.setrow b{text-align:center;margin-bottom:14px}.setrow input{padding:5px;text-align:center}.setrow button{height:44px;padding:0;border:0;border-radius:9px;background:#39485e;color:white;font-size:22px}.setheader{display:grid;grid-template-columns:32px 1fr 1fr 1fr 40px;gap:7px;text-align:center;font-size:11px;color:#a5b7cd}.result{border-left:4px solid #60a5fa;background:#0e2237;border-radius:10px;padding:15px;margin-top:15px}.result strong{font-size:22px;display:block;margin:4px 0}.muted{color:#a9bdd0}.history{padding:10px 0;border-bottom:1px solid #334258}.history:last-child{border:0}.bar{background:#2c3b51;height:8px;border-radius:12px;overflow:hidden;margin-top:7px}.fill{height:100%;background:#60a5fa}.visuallyhidden{position:absolute;clip:rect(0,0,0,0);width:1px;height:1px;overflow:hidden}footer{text-align:center;color:#8191a7;font-size:12px;padding:20px}#message{position:fixed;bottom:15px;left:20px;right:20px;max-width:680px;margin:auto;background:#d9eeff;color:#071323;border-radius:12px;padding:12px;display:none;z-index:10} @media(max-width:420px){main{padding:12px}.panel{padding:13px}.setrow{grid-template-columns:22px 1fr 1fr 1fr 33px;gap:5px}.setrow button{width:33px}h1{font-size:23px}}
</style><style>html, body, #root {
      margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0;
      
    }
html,body,#root{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}html,body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Helvetica Neue,Arial,sans-serif!important}button,input,textarea,select{font-family:inherit}html{background-color:transparent}html.chatgptOled.dark,html.mobileSkybridge.dark{background-color:#000}@supports (font: -apple-system-body){html.mobileSkybridge{font:-apple-system-body}}html.desktopSkybridge.dark{background-color:#1e1e1e}html.transparentSkybridgeBackground,html.transparentSkybridgeBackground.dark{background-color:transparent}html.androidSkybridge,html.androidSkybridge body,html.androidSkybridge *{-webkit-tap-highlight-color:rgba(255,255,255,0)}html.androidSkybridge *::selection,html.androidSkybridge *::-moz-selection{background:#fff0;color:inherit}</style></head><body><main><header><div><div class="small">DEIN TRAINING. DEINE PROGRESSION.</div><h1>GYM Progress <span style="color:#60a5fa">‚óè</span></h1></div><span class="pill">Prototyp 1.0</span></header>
<section class="panel"><h2>1 ¬∑ Trainingsprofil</h2><div class="cols"><div><label for="profile">Profil ausw√§hlen</label><select id="profile"><option value="p1">Mein Profil</option></select></div><div><label for="newProfile">Neues Profil</label><div class="toolbar" style="flex-wrap:nowrap"><input id="newProfile" placeholder="Name" maxlength="40"><button class="button" id="addProfile" aria-label="Profil hinzuf√ºgen">+</button></div></div></div><p class="small">Die Profile bleiben in dieser Testversion nur auf diesem Ger√§t. Keine Online-Konten und keine Synchronisierung.</p></section>
<section class="panel"><h2>2 ¬∑ Training einstellen</h2><div class="field"><label for="exercise">√úbung</label><select id="exercise"><option value="Bankdr√ºcken">Bankdr√ºcken</option><option value="Kniebeugen">Kniebeugen</option><option value="Kreuzheben">Kreuzheben</option><option value="Schulterdr√ºcken">Schulterdr√ºcken</option><option value="Latzug">Latzug</option><option value="Rudern">Rudern</option><option value="Beinpresse">Beinpresse</option><option value="Bizepscurls">Bizepscurls</option></select></div><div class="toolbar"><input style="flex:1;min-width:150px" id="newExercise" placeholder="Neue √úbung" maxlength="55"><button class="button alt" id="addExercise">Hinzuf√ºgen</button></div><div class="cols"><div class="field"><label for="minReps">Wdh. von</label><input id="minReps" type="number" min="1" max="50" step="1" value="8"></div><div class="field"><label for="maxReps">Wdh. bis</label><input id="maxReps" type="number" min="1" max="50" step="1" value="12"></div></div><div class="cols"><div class="field"><label for="increment">Gewichtssteigerung (kg)</label><input id="increment" type="number" min="0.25" max="25" step="0.25" value="2.5"></div><div class="field"><label for="readiness">Tagesform (1‚Äì5)</label><select id="readiness"><option value="1">1 ¬∑ Stark ersch√∂pft</option><option value="2">2 ¬∑ Eher m√ºde</option><option value="3" selected="">3 ¬∑ Normal</option><option value="4">4 ¬∑ Gut erholt</option><option value="5">5 ¬∑ Sehr gut erholt</option></select></div></div></section>
<section class="panel"><h2>3 ¬∑ Arbeitss√§tze erfassen</h2><p class="small">RIR = gesch√§tzte saubere Wiederholungen, die du noch geschafft h√§ttest. Beispiel: RIR 2 bedeutet, dass noch zwei Wiederholungen m√∂glich gewesen w√§ren.</p><div class="setheader"><span>Satz</span><span>kg</span><span>Wdh.</span><span>RIR</span><span></span></div><div id="sets"><div class="setrow"><b>1</b><input type="number" data-kind="kg" min="0" max="1000" step="0.25" aria-label="kg Satz 1"><input type="number" data-kind="reps" min="0" max="60" step="1" aria-label="reps Satz 1"><input type="number" data-kind="rir" min="0" max="10" step="1" aria-label="rir Satz 1"><button title="Satz entfernen">√ó</button></div><div class="setrow"><b>2</b><input type="number" data-kind="kg" min="0" max="1000" step="0.25" aria-label="kg Satz 2"><input type="number" data-kind="reps" min="0" max="60" step="1" aria-label="reps Satz 2"><input type="number" data-kind="rir" min="0" max="10" step="1" aria-label="rir Satz 2"><button title="Satz entfernen">√ó</button></div><div class="setrow"><b>3</b><input type="number" data-kind="kg" min="0" max="1000" step="0.25" aria-label="kg Satz 3"><input type="number" data-kind="reps" min="0" max="60" step="1" aria-label="reps Satz 3"><input type="number" data-kind="rir" min="0" max="10" step="1" aria-label="rir Satz 3"><button title="Satz entfernen">√ó</button></div></div><div class="toolbar"><button class="button alt" id="addSet">+ Satz</button><button class="button" id="save">Training speichern</button></div><div id="recommendation" class="result" aria-live="polite"><span class="pill ">Gewicht halten</span><strong>40 kg f√ºr die n√§chste Einheit</strong><p>Steigere zun√§chst die Wiederholungen innerhalb des Zielbereichs, ohne die gew√ºnschte Technik und RIR aufzugeben.</p></div></section>
<section class="panel"><h2>4 ¬∑ Dein Verlauf</h2><p class="small" id="historyHint">Gespeicherte Einheiten f√ºr die ausgew√§hlte √úbung.</p><div id="history"><p>Noch keine Trainingsdaten. Speichere deine erste Einheit.</p></div></section>
<section class="panel"><h2>5 ¬∑ Datensicherung</h2><p class="small">Die Daten liegen ausschlie√ülich lokal im Browser. Bei gel√∂schten Browserdaten k√∂nnen sie verloren gehen. Deshalb regelm√§√üig als Datei sichern.</p><div class="toolbar"><button class="button alt" id="export">Daten exportieren</button><label for="import" class="button alt" style="display:inline-flex;align-items:center;margin:0;cursor:pointer">Daten importieren</label><input class="visuallyhidden" type="file" id="import" accept="application/json,.json"></div></section><footer>Trainingsvorschl√§ge sind Orientierungshilfen, kein Ersatz f√ºr sichere Technik und angemessene Belastungssteuerung.</footer></main><div id="message" role="status"></div><script>
'use strict';
const KEY='gym-progress-v1';const qs=s=>document.querySelector(s);const DEFAULT=['Bankdr√ºcken','Kniebeugen','Kreuzheben','Schulterdr√ºcken','Latzug','Rudern','Beinpresse','Bizepscurls'];
const clean=()=>({profiles:[{id:'p1',name:'Mein Profil'}],active:'p1',exercises:[...DEFAULT],sessions:[],settings:{}});
let db;try{let saved=JSON.parse(localStorage.getItem(KEY));db=saved&&Array.isArray(saved.profiles)&&Array.isArray(saved.exercises)&&Array.isArray(saved.sessions)?saved:clean()}catch(e){db=clean()}
function persist(){try{localStorage.setItem(KEY,JSON.stringify(db));return true}catch(e){notify('Speichern fehlgeschlagen: Browserspeicher nicht verf√ºgbar.');return false}}
function notify(message){let n=qs('#message');n.textContent=message;n.style.display='block';setTimeout(()=>n.style.display='none',3200)}
function el(tag,txt,cls){let x=document.createElement(tag);if(txt!==undefined)x.textContent=txt;if(cls)x.className=cls;return x}
function id(){return (crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2))}
function renderProfiles(){let p=qs('#profile');p.replaceChildren();for(let prof of db.profiles){let o=new Option(prof.name,prof.id);p.add(o)}if(!db.profiles.some(x=>x.id===db.active))db.active=db.profiles[0].id;p.value=db.active}
function currentExercise(){return qs('#exercise').value}
function settingsKey(){return db.active+'::'+currentExercise()}
function saveSettings(){if(!currentExercise())return;db.settings[settingsKey()]={min:Number(qs('#minReps').value),max:Number(qs('#maxReps').value),increment:Number(qs('#increment').value)};persist()}
function renderExercises(){let x=qs('#exercise'),prev=x.value;x.replaceChildren();db.exercises.forEach(a=>x.add(new Option(a,a)));x.value=db.exercises.includes(prev)?prev:db.exercises[0];loadExercise()}
function loadExercise(){let s=db.settings[settingsKey()]||{min:8,max:12,increment:2.5};qs('#minReps').value=s.min;qs('#maxReps').value=s.max;qs('#increment').value=s.increment;renderHistory();prefill();calculate()}
function sessionList(){return db.sessions.filter(s=>s.profile===db.active&&s.exercise===currentExercise()).sort((a,b)=>b.time-a.time)}
function prefill(){let latest=sessionList()[0],target=latest?.recommendation?.weight;let weight=Number.isFinite(target)?target:latest?.sets?.[0]?.kg??40;let reps=Number(qs('#minReps').value)||8;qs('#sets').replaceChildren();for(let i=0;i<3;i++)addSet(weight,reps,2)}
function addSet(kg=40,reps=8,rir=2){let wrap=el('div',undefined,'setrow');let idx=el('b',String(qs('#sets').children.length+1));wrap.append(idx);for(let [name,val,min,max,step] of [['kg',kg,0,1000,.25],['reps',reps,0,60,1],['rir',rir,0,10,1]]){let input=el('input');input.type='number';input.dataset.kind=name;input.min=min;input.max=max;input.step=step;input.value=val;input.setAttribute('aria-label',name+' Satz '+(qs('#sets').children.length+1));input.addEventListener('input',calculate);wrap.append(input)}let remove=el('button','√ó');remove.title='Satz entfernen';remove.onclick=()=>{if(qs('#sets').children.length===1){notify('Mindestens ein Satz erforderlich');return}wrap.remove();[...qs('#sets').children].forEach((r,i)=>r.firstChild.textContent=i+1);calculate()};wrap.append(remove);qs('#sets').append(wrap);calculate()}
function readSets(){return [...qs('#sets').children].map(row=>{let a=[...row.querySelectorAll('input')].map(x=>x.value.trim()===''?NaN:Number(x.value));return {kg:a[0],reps:a[1],rir:a[2]}})}
function validated(silent=false){let min=Number(qs('#minReps').value),max=Number(qs('#maxReps').value),inc=Number(qs('#increment').value),sets=readSets();let good=Number.isInteger(min)&&min>=1&&min<=50&&Number.isInteger(max)&&max>=min&&max<=50&&inc>=.25&&inc<=25&&sets.length>0&&sets.every(s=>Number.isFinite(s.kg)&&s.kg>0&&s.kg<=1000&&Number.isInteger(s.reps)&&s.reps>=0&&s.reps<=60&&Number.isInteger(s.rir)&&s.rir>=0&&s.rir<=10);if(!good&&!silent)notify('Bitte g√ºltige Werte eingeben (mindestens ein Satz, Gewicht √ºber 0).');return good?{min,max,inc,sets,readiness:Number(qs('#readiness').value)}:null}
function rounded(v){return Math.round(v*100)/100}
function recommend(d,history){let sets=d.sets,base=sets[0].kg,same=sets.every(s=>Math.abs(s.kg-base)<.001),allAtTop=same&&sets.every(s=>s.reps>=d.max&&s.rir>=1&&s.rir<=3),lowRecovery=d.readiness<=2,nearFailure=sets.filter(s=>s.rir===0).length>=Math.ceil(sets.length/2);let previous=history[0],prevBad=previous&&previous.readiness<=2;let decrease=lowRecovery&&prevBad;let weight=base,reason='',tag='Gewicht halten';if(decrease){weight=rounded(Math.max(.25,base-d.inc));tag='Belastung reduzieren';reason='An zwei aufeinanderfolgenden Einheiten war die Tagesform niedrig. Reduziere versuchsweise das Gewicht um eine Stufe und pr√ºfe deine Erholung.'}else if(lowRecovery){reason='Deine Tagesform ist heute niedrig. Kein automatischer Anstieg; bei Bedarf weniger S√§tze oder leichter trainieren.'}else if(nearFailure){reason='Mehrere S√§tze endeten bei RIR 0. Gewicht zun√§chst halten und auf kontrollierte Wiederholungen achten.'}else if(allAtTop){weight=rounded(base+d.inc);tag='Gewicht steigern';reason='Alle S√§tze liegen am oberen Wiederholungsziel mit 1‚Äì3 RIR. Eine kleine Steigerung ist plausibel.'}else if(!same){reason='Du hast unterschiedliche Satzgewichte verwendet. Wiederhole die Einheit kontrolliert; f√ºr eine klare Steigerungsregel sollten die Arbeitss√§tze vergleichbar sein.'}else{reason='Steigere zun√§chst die Wiederholungen innerhalb des Zielbereichs, ohne die gew√ºnschte Technik und RIR aufzugeben.'}return {weight,tag,reason}}
function calculate(){let v=validated(true),out=qs('#recommendation');if(!v){out.replaceChildren(el('span','Trage g√ºltige Satzwerte ein, um eine Empfehlung zu erhalten.'));return}let r=recommend(v,sessionList());out.replaceChildren(el('span',r.tag,'pill '+(r.tag==='Gewicht steigern'?'ok':r.tag==='Belastung reduzieren'?'warn':'')),el('strong',r.weight.toLocaleString('de-DE')+' kg f√ºr die n√§chste Einheit'),el('p',r.reason));}
function renderHistory(){let h=qs('#history'),arr=sessionList();h.replaceChildren();if(!arr.length){h.append(el('p','Noch keine Trainingsdaten. Speichere deine erste Einheit.'));return}for(let s of arr.slice(0,12)){let item=el('div',undefined,'history');let dt=new Date(s.time).toLocaleDateString('de-DE',{day:'2-digit',month:'short',year:'numeric'});let volume=s.sets.reduce((acc,a)=>acc+a.kg*a.reps,0);item.append(el('strong',dt+' ¬∑ '+volume.toLocaleString('de-DE')+' kg Volumen'));item.append(el('div',s.sets.map(v=>`${v.kg} kg √ó ${v.reps} (RIR ${v.rir})`).join(' ¬∑ '),'small'));let chart=el('div',undefined,'bar'),fill=el('div',undefined,'fill');fill.style.width=Math.max(2,Math.min(100,volume/Math.max(1,...arr.map(a=>a.sets.reduce((n,b)=>n+b.kg*b.reps,0)))*100))+'%';chart.append(fill);item.append(chart);h.append(item)}}
qs('#addProfile').onclick=()=>{let name=qs('#newProfile').value.trim();if(!name)return notify('Bitte einen Profilnamen eingeben');if(db.profiles.length>=20)return notify('Maximal 20 Testprofile');let p={id:id(),name};db.profiles.push(p);db.active=p.id;persist();qs('#newProfile').value='';renderProfiles();loadExercise();notify('Profil angelegt')};
qs('#profile').onchange=()=>{db.active=qs('#profile').value;persist();loadExercise()};
qs('#addExercise').onclick=()=>{let name=qs('#newExercise').value.trim();if(!name)return notify('Bitte eine √úbung eingeben');if(db.exercises.some(e=>e.toLocaleLowerCase()===name.toLocaleLowerCase()))return notify('√úbung ist schon vorhanden');db.exercises.push(name);persist();qs('#newExercise').value='';renderExercises();qs('#exercise').value=name;loadExercise()};
qs('#exercise').onchange=loadExercise;['minReps','maxReps','increment'].forEach(key=>qs('#'+key).addEventListener('change',()=>{if(validated(true)){saveSettings();calculate()}}));qs('#readiness').onchange=calculate;qs('#addSet').onclick=()=>{let a=readSets();let last=a.at(-1);addSet(last?.kg||40,last?.reps||8,last?.rir??2)};
qs('#save').onclick=()=>{let v=validated();if(!v)return;let history=sessionList(),rec=recommend(v,history);db.sessions.push({id:id(),profile:db.active,exercise:currentExercise(),time:Date.now(),...v,recommendation:rec});saveSettings();if(persist()){renderHistory();notify('Training gespeichert');prefill()}};
qs('#export').onclick=()=>{let blob=new Blob([JSON.stringify({...db,exportedAt:new Date().toISOString()},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=el('a');a.href=url;a.download='gym-progress-backup-'+new Date().toISOString().slice(0,10)+'.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)};
qs('#import').onchange=async ev=>{let file=ev.target.files[0];if(!file)return;try{let incoming=JSON.parse(await file.text());if(!Array.isArray(incoming.profiles)||!incoming.profiles.length||!Array.isArray(incoming.exercises)||!incoming.exercises.length||!Array.isArray(incoming.sessions)||!incoming.settings||typeof incoming.settings!=='object')throw Error();if(!confirm('Alle vorhandenen lokalen Trainingsdaten durch die Datei ersetzen?'))return;db={profiles:incoming.profiles,active:incoming.active,exercises:incoming.exercises,sessions:incoming.sessions,settings:incoming.settings};if(!db.profiles.some(p=>p.id===db.active))db.active=db.profiles[0].id;persist();renderProfiles();renderExercises();notify('Backup geladen')}catch(e){notify('Die Datei ist kein g√ºltiges GYM-Progress-Backup.')}finally{ev.target.value=''}};
renderProfiles();renderExercises();if('serviceWorker' in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('./service-worker.js').catch(()=>{});
</script>
<script>globalThis.__codexVisualizationInitialGlobals={"statePersistence":"none","stateModelContext":"none","visualizationStyleVariables":{"--accent":"rgb(232, 243, 254)","--accent-foreground":"rgb(44, 103, 197)","--background":"rgb(252, 252, 252)","--border":"rgba(0, 0, 0, 0.1)","--border-strong":"rgba(0, 0, 0, 0.15)","--card":"color-mix(in oklab, rgb(13, 13, 13) 5%, transparent)","--card-foreground":"rgb(13, 13, 13)","--corner-shape":"round","--control-spacing":"12px","--cursor-interaction":"pointer","--destructive":"rgb(146, 59, 15)","--font-mono":"ui-monospace, SFMono-Regular, \"SF Mono\", menlo, consolas, \"Liberation Mono\", monospace","--font-sans":"-apple-system-body, ui-sans-serif, -apple-system, system-ui, \"Segoe UI\", Helvetica, \"Apple Color Emoji\", Arial, sans-serif, \"Segoe UI Emoji\", \"Segoe UI Symbol\"","--font-size-base":"16px","--font-weight-normal":"400","--foreground":"rgb(13, 13, 13)","--input":"rgba(0, 0, 0, 0.15)","--muted":"color-mix(in srgb, rgb(13, 13, 13) 10%, transparent)","--muted-foreground":"rgb(143, 143, 143)","--popover":"rgb(255, 255, 255)","--popover-foreground":"rgb(13, 13, 13)","--primary":"rgb(44, 103, 197)","--primary-foreground":"rgb(255, 255, 255)","--radius":"8px","--radius-2xl":"16px","--radius-lg":"8px","--radius-md":"6px","--radius-sm":"4px","--ring":"rgb(1, 105, 204)","--secondary":"rgb(243, 243, 243)","--secondary-foreground":"rgb(13, 13, 13)","--blue":"rgb(2, 133, 255)","--orange":"rgb(251, 106, 34)","--green":"rgb(4, 184, 76)","--red":"rgb(250, 66, 62)","--purple":"rgb(146, 79, 247)","--yellow":"rgb(255, 195, 0)","--visualize-paint-gutter":"0px","--viz-series-1":"rgb(44, 103, 197)","--viz-series-2":"#f2893c","--viz-series-3":"#5ec978","--viz-series-4":"#ea77b0","--viz-series-5":"#9a7aeb","--viz-series-6":"#3db9b0"},"visualizationTheme":"light"};</script>
<style id="codex-visualization-host-theme">
:root {}
</style>
<script>
(() => {
  // Host colors are defaults; later authored styles can give the same names
  // their own meaning (for example, --muted as a chart's label color).
  const hostStyles = document.getElementById("codex-visualization-host-theme");
  const hostStyle = hostStyles.sheet.cssRules[0].style;
  // Typography, geometry and interaction cursors still follow the host.
  const styleForProperty = (property) =>
    /^--(?:font-|radius|corner-shape$|control-spacing$|cursor-interaction$|icon-size$|page-content-inline-inset$|page-header-clearance$|visualize-paint-gutter$)/.test(property)
      ? document.documentElement.style
      : hostStyle;
  const initialGlobals =
    globalThis.__codexVisualizationInitialGlobals ?? globalThis.openai;
  delete globalThis.__codexVisualizationInitialGlobals;
  if (initialGlobals?.statePersistence != null) {
    globalThis.openai ??= {};
    globalThis.openai.statePersistence = initialGlobals.statePersistence;
    globalThis.openai.stateModelContext = initialGlobals.stateModelContext ?? "none";
  }
  if (!false) {
