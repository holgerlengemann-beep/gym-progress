/async/6df3d9c96b95.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/4c1c4e0e876a.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/659090139b52.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/e1e3759c7b45.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/5a7fee8bc017.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/a59c69dc1850.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/f813678c40c7.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/d451e91e82d2.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/225b7e817ac3.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/32a486438198.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/85c28265522b.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/d1d10241e971.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/124929f9f06e.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/c56e66b9a94c.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/4faa8aa27d45.css"><link rel="stylesheet" type="text/css" href="/cdn/assets/async/0fbf1d328629.css"></head><body data-contain-pane-overscroll="" style="--text-page-body: 15px; --page-font-scale: 1.0714285714285714; --font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><span data-radix-focus-start="" style="display:contents"></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
